# Copy to .env and fill in. Loaded by process-compose and Task.

# Hatchet runs via `hatchet server start`; clients load its CLI profile.
HATCHET_PROFILE=local

# Caddy (tailnet dashboards). Auth key is only needed on first run.
TS_AUTHKEY=
# Tailscale logins allowed into dashboards, comma-separated.
ROAMIND_DASHBOARD_USERS=me@example.com

# Slack app (OAuth & Permissions → Bot User OAuth Token; Basic Information → Signing Secret)
SLACK_BOT_TOKEN=xoxb-
SLACK_SIGNING_SECRET=

# Roamind
ROAMIND_DATA_DIR=./data
# The repo's memory folder; the user-setup workflow sets new users' Basic
# Memory projects up from it.
# ROAMIND_MEMORY_DIR=./memory
# claude model alias or id; empty uses claude's default.
ROAMIND_MODEL=
# Basic Memory CLI for long-term memory (uv tool install basic-memory);
# memory is off if it is not found. Its search models run on the GPU via
# vLLM (task vllm; process-compose services embed and rerank).
# ROAMIND_BM_BIN=bm
# Roamind's MCP server (task mcp); defaults to mcp next to the worker
# binary. Without it, chat turns run without its tools.
# ROAMIND_MCP_BIN=bin/mcp
# Timezone of the 9:00 daily exercises for learning goals; empty uses the
# server's zone.
# ROAMIND_TZ=Europe/Berlin

# Job assistant: the web app's Firebase project. The worker reads profiles
# and resumes and writes applications with a service account key (Firebase
# console → Project settings → Service accounts); without a project there
# is no job assistant. Contract: docs/web.md.
# FIREBASE_PROJECT_ID=
# FIREBASE_STORAGE_BUCKET=<project>.firebasestorage.app
# GOOGLE_APPLICATION_CREDENTIALS=./data/secrets/firebase-sa.json
# Postings a daily job hunt picks at most (default 5).
# ROAMIND_JOBS_PER_RUN=5
# Domains, with their subdomains, the job search never reads,
# comma-separated.
# ROAMIND_JOBS_BLOCKED_DOMAINS=
