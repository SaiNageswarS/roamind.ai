# Copy to .env and fill in. Loaded by process-compose and ./build.sh.

# Hatchet runs via `hatchet server start`; clients load its CLI profile.
HATCHET_PROFILE=local

# Caddy (tailnet dashboards). Auth key is only needed on first run.
TS_AUTHKEY=
# Tailscale logins allowed into dashboards, comma-separated.
ROAMIND_DASHBOARD_USERS=me@example.com

# Slack app (OAuth & Permissions → Bot User OAuth Token; Basic Information → Signing Secret)
SLACK_BOT_TOKEN=xoxb-
SLACK_SIGNING_SECRET=

# Roamind
ROAMIND_DATA_DIR=./data
# Comma-separated emails allowed to use the agent ("*" = everyone).
ROAMIND_ALLOWED_EMAILS=
# claude model alias or id; empty uses claude's default.
ROAMIND_MODEL=
# Basic Memory CLI for long-term memory (uv tool install basic-memory);
# memory is off if it is not found. Its search models run on the GPU via
# vLLM (./build.sh vllm; process-compose services embed and rerank).
# ROAMIND_BM_BIN=bm
